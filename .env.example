# Runtime configuration. In Docker these come from docker-compose.yml / .env;
# for `pnpm dev` put them here (Vite loads .env into the server).

# Where the database (SQLite mode) and all media live.
# DATA_DIR is the path inside the process (pnpm dev; the container uses /data).
# DATA_PATH is the host folder docker-compose mounts at /data — set it to a
# mounted volume like /mnt/fartingaround-data, or leave unset for ./data.
DATA_DIR=./data
DATA_PATH=

# Which published image of the site to run (docker-compose.yml): latest (the
# newest release, the default), edge (every commit on main), or one release
# such as 0.2.0. `fa deploy` downloads the newest image for this choice.
# FA_BUILD=1 makes `fa deploy` build from this checkout instead.
FA_VERSION=
FA_BUILD=

# A second site on the same server (`fa add` writes these; leave them out otherwise):
#   FA_CONTAINER=fa-notes            the container's name
#   COMPOSE_PROJECT_NAME=fa-notes    keeps its containers apart from the first site's
#   DEBUG_PORT=8407                  its own on-host port

# Leave empty for SQLite at DATA_DIR/site.db. Set for Postgres, e.g.
# postgres://fartingaround:password@localhost:5432/fartingaround
DATABASE_URL=

# Password for /admin
ADMIN_PASSWORD=change-me

# Bearer token the phone app uses for /api/drafts*  (openssl rand -hex 32)
CAPTURE_API_TOKEN=

# Optional: HMAC secret for upload URLs. Derived from ADMIN_PASSWORD when unset.
UPLOAD_SECRET=

# Optional: if the site is behind Cloudflare's proxy (orange cloud), its 100 MB
# request-body cap would reject big video uploads from the phone. Create a
# DNS-only (grey cloud) hostname pointing at the same server and name it here;
# signed upload URLs will use it. Leave empty otherwise.
UPLOAD_ORIGIN=

# Optional: an ElevenLabs API key turns on the "Transcribe" button for audio
# captions on photo-dump photos in /admin (Scribe speech-to-text, with word
# timestamps for closed-caption style playback). Leave empty to skip.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=scribe_v1
